# Environment for docker-compose-example.yml (production / self-hosting).
# Copy to .env next to the compose file and fill in the values:
#   cp example.env .env
# Every variable the compose file reads is listed here. Values shown for
# optional settings are the defaults; you can delete any line you don't change.

# Optional: lets a plain `docker compose ...` use the production compose file
# instead of passing -f every time.
# COMPOSE_FILE=docker-compose.server.yml

# =============================================================================
# Required
# =============================================================================

# Password for the bundled Postgres database. The stack refuses to start
# without it. Use a long random string, e.g. the output of: openssl rand -hex 32
POSTGRES_PASSWORD=<long-random-password>

# URL(s) the dashboard is opened from, comma-separated. The backend rejects
# browser requests from any other origin. Must match your domain exactly,
# including https:// and without a trailing slash.
CORS_ORIGINS=https://<your-domain>

# =============================================================================
# AI chat (optional)
# =============================================================================

# Google Gemini API key for the chat assistant. Leave empty to disable chat;
# monitoring works without it. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# Gemini model used by the chat assistant.
AGENT_MODEL=models/gemini-3.5-flash

# =============================================================================
# Accounts and login sessions
# =============================================================================

# When false, only the first account can register; after that, sign-up is
# closed. Set to true to let anyone who can reach the site create an account.
# Only the exact value "true" enables it.
ALLOW_REGISTRATION=false

# Send the login cookie over HTTPS only. Keep true when served through Traefik
# over HTTPS; set to false only if you use the dashboard over plain HTTP,
# otherwise you won't be able to stay logged in.
SESSION_COOKIE_SECURE=true

# How long a login lasts, in seconds (86400 = 24 hours).
SESSION_TTL_SECONDS=86400

# Name of the login cookie. Change it only if it clashes with another app on
# the same domain.
SESSION_COOKIE_NAME=homie_session

# =============================================================================
# Rate limits (brute-force protection)
# =============================================================================

# Failed login attempts allowed per window, counted separately per IP address
# and per email. A successful login resets the count. Over the limit, logins
# get "429 Too many attempts" until the window ends.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Registration attempts allowed per IP address per window (3600 = 1 hour).
REGISTER_RATE_LIMIT=3
REGISTER_RATE_WINDOW_SECONDS=3600

# =============================================================================
# Alerts (optional)
# =============================================================================

# URL that receives a JSON POST when a health check finds a critical problem.
# Leave empty to disable. Example: https://your-alert-endpoint.example/health
ADMIN_ALERT_WEBHOOK_URL=

# =============================================================================
# Local collector (monitors the machine running this stack)
# =============================================================================

# New machines appear under "New servers detected" on the dashboard and must
# be approved. Set an enrollment key (dashboard: Connect a server -> Advanced)
# to have this machine approved automatically. Leave empty to approve by hand.
HOMELAB_ENROLL_KEY=

# Name shown on the dashboard for this machine. Empty = use its hostname.
HOMELAB_SERVER_NAME=

# How often the collector sends metrics, in seconds. Minimum 15.
HOMELAB_CHECK_INTERVAL_SECONDS=60

# Unique ID of this machine. Empty = read /etc/machine-id from the host.
# Set it only if several machines share the same machine-id (e.g. cloned VMs)
# and would otherwise show up as one server.
HOMELAB_MACHINE_ID=

# =============================================================================
# Dashboard (frontend)
# =============================================================================

# Address and port where the dashboard is served over plain HTTP on the host.
# 127.0.0.1 keeps it reachable only from this machine (Traefik still reaches it
# over the Docker network). Use 0.0.0.0 for direct LAN/VPN access.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=5173

# How often live graphs refresh, in seconds (minimum 1). This is baked in when
# the image is built, so rebuild after changing it:
#   docker compose up -d --build frontend
LIVE_GRAPH_REFRESH_INTERVAL_SECONDS=3

# =============================================================================
# Not configurable here
# =============================================================================
# The code also reads DATABASE_URL, REDIS_URL, HOMELAB_API_URL, PROMPTS_DIR,
# DOCKER_SOCKET_PATH, HOST_PROC, HOST_ROOT, HOMELAB_STATE_DIR and
# VITE_API_BASE_URL. The compose file sets these to match its own containers,
# volumes and ports, so setting them in .env has no effect.
