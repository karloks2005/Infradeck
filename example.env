# Environment for docker-compose.server.yml (production / self-hosting behind Traefik).
# Copy to .env next to the compose file and fill in the values:
#   cp example.env .env
# Every variable the compose file reads is listed here. Values shown for
# optional settings are the defaults; you can delete any line you don't change.

# Strongly recommended: makes a plain `docker compose ...` use the production compose file.
# Without it Compose picks compose.yml (the development stack) and would replace your server
# containers with ones that have no Traefik labels and open registration.
COMPOSE_FILE=docker-compose.server.yml

# =============================================================================
# Required
# =============================================================================

# Password for the bundled Postgres database. The stack refuses to start
# without it. Use a long random string, e.g. the output of: openssl rand -hex 32
POSTGRES_PASSWORD=<long-random-password>

# The domain the dashboard is served on (no https://, no slash). Used for the Traefik router
# and as the default for CORS_ORIGINS below.
DASHBOARD_DOMAIN=<your-domain>

# Your Traefik setup. Defaults shown; set them to match your Traefik's static configuration
# (entryPoints / certificatesResolvers) and the Docker network it is attached to
# (docker network ls, or: docker inspect <traefik-container> --format '{{json .NetworkSettings.Networks}}').
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=traefik_default
# Name of this dashboard's Traefik router and service; only change it if it clashes with another one.
TRAEFIK_ROUTER=homelab

# URL(s) the dashboard is opened from, comma-separated, if it differs from https://<DASHBOARD_DOMAIN>
# (for example a second address). Browser requests from other origins are rejected. Include
# https:// and no trailing slash. Leave commented to use the default.
# CORS_ORIGINS=https://<your-domain>

# =============================================================================
# Secrets at rest (needed for two-factor sign-in)
# =============================================================================

# Key that encrypts secrets the app must read back, such as two-factor secrets. Without it two-factor
# can't be set up and is not enforced. Keep it out of backups of the database. Generate one with:
#   docker compose run --rm backend python -m src.backend.secrets_box
# To rotate, put the new key first and keep the old one after a comma: SECRETS_KEY=<new>,<old>
SECRETS_KEY=

# =============================================================================
# AI chat (optional)
# =============================================================================

# Google Gemini API key for the chat assistant. Leave empty to disable chat;
# monitoring works without it. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# Gemini model used by the chat assistant.
AGENT_MODEL=models/gemini-3.5-flash

# =============================================================================
# Accounts and login sessions
# =============================================================================

# When false, only the first account can register; after that, sign-up is
# closed. Set to true to let anyone who can reach the site create an account.
# Only the exact value "true" enables it.
ALLOW_REGISTRATION=false

# Send the login cookie over HTTPS only. Keep true when served through Traefik
# over HTTPS; set to false only if you use the dashboard over plain HTTP,
# otherwise you won't be able to stay logged in.
SESSION_COOKIE_SECURE=true

# How long a login lasts, in seconds (86400 = 24 hours).
SESSION_TTL_SECONDS=86400

# Name of the login cookie. Change it only if it clashes with another app on
# the same domain.
SESSION_COOKIE_NAME=homie_session

# =============================================================================
# Limits (the defaults suit most installs)
# =============================================================================

# The most servers this install will hold, however they are added.
# MAX_SERVERS=200

# A check-in must arrive at least this share of the server's check interval after the previous one;
# faster ones are refused (429). 0 switches the limit off.
# INGEST_MIN_SPACING_RATIO=0.25

# Serves the interactive API documentation at /api/docs. Leave off on a public install.
# ENABLE_API_DOCS=false

# Setup token for the very first account (the one that becomes the admin).
# Leave it commented: the backend then makes one up and prints it in its log
# ("docker compose logs backend | grep 'setup token'") until the first account exists.
# ADMIN_BOOTSTRAP_TOKEN=

# How long the token created by "Connect a server" stays valid, in seconds.
# JOIN_TOKEN_TTL_SECONDS=900

# =============================================================================
# Rate limits (brute-force protection)
# =============================================================================

# Failed login attempts allowed per window, counted separately per IP address
# and per email. A successful login resets the count. Over the limit, logins
# get "429 Too many attempts" until the window ends.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Registration attempts allowed per IP address per window (3600 = 1 hour).
REGISTER_RATE_LIMIT=3
REGISTER_RATE_WINDOW_SECONDS=3600

# =============================================================================
# Alerts (optional)
# =============================================================================

# URL that receives a JSON POST when a health check finds a critical problem.
# Leave empty to disable. Example: https://your-alert-endpoint.example/health
ADMIN_ALERT_WEBHOOK_URL=

# =============================================================================
# Local collector (monitors the machine running this stack)
# =============================================================================

# New machines appear under "New servers detected" on the dashboard and must
# be approved. Set an enrollment key (dashboard: Connect a server -> Advanced)
# to have this machine approved automatically. Leave empty to approve by hand.
HOMELAB_ENROLL_KEY=

# Name shown on the dashboard for this machine. Empty = use its hostname.
HOMELAB_SERVER_NAME=

# How often the collector sends metrics, in seconds. Minimum 15.
HOMELAB_CHECK_INTERVAL_SECONDS=60

# Unique ID of this machine. Empty = read /etc/machine-id from the host.
# Set it only if several machines share the same machine-id (e.g. cloned VMs)
# and would otherwise show up as one server.
HOMELAB_MACHINE_ID=

# =============================================================================
# Dashboard (frontend)
# =============================================================================

# Address and port where the dashboard is served over plain HTTP on the host.
# 127.0.0.1 keeps it reachable only from this machine (Traefik still reaches it
# over the Docker network). Use 0.0.0.0 for direct LAN/VPN access.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=5173

# Optional internet-reachability check run by the collector, off when empty. Comma-separated
# host:port targets (hostnames or IPv4, at most 5); it only opens a TCP connection and looks the name
# up, sending nothing. Set per collector, never from the dashboard. Example: 1.1.1.1:443,9.9.9.9:443
HOMELAB_CONNECTIVITY_TARGETS=

# --- Connecting remote servers over a VPN (docker-compose.server.yml) ---
# Collectors never use the public address. They report to the collector gate, which you
# publish on your VPN address only (for OpenVPN, the server's tun address, e.g. 10.8.0.1).
# Docker's published ports bypass ufw and similar firewalls, so bind to the VPN address
# instead of 0.0.0.0 and relying on a firewall rule.
COLLECTOR_BIND=127.0.0.1
COLLECTOR_PORT=8081
# What the "Connect a server" panel tells new machines to use, e.g. http://10.8.0.1:8081/api
COLLECTOR_PUBLIC_URL=
# Images remote hosts install, pinned by digest. Push a version tag (git tag v0.1.0 &&
# git push origin v0.1.0); the "Publish images" workflow prints these lines in its summary.
# The GHCR packages must be public for hosts to pull them without credentials.
COLLECTOR_IMAGE=
DOCKER_PROXY_IMAGE=

# How often live graphs refresh, in seconds (minimum 1). This is baked in when
# the image is built, so rebuild after changing it:
#   docker compose up -d --build frontend
LIVE_GRAPH_REFRESH_INTERVAL_SECONDS=3

# =============================================================================
# Not configurable here
# =============================================================================
# The code also reads DATABASE_URL, REDIS_URL, HOMELAB_API_URL, PROMPTS_DIR,
# DOCKER_SOCKET_PATH, HOST_PROC, HOST_ROOT, HOMELAB_STATE_DIR and
# VITE_API_BASE_URL. The compose file sets these to match its own containers,
# volumes and ports, so setting them in .env has no effect.
