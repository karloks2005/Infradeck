# Copy to .env, set POSTGRES_PASSWORD, then run: docker compose up -d --build
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional: required only if you use the Gemini chat feature.
GEMINI_API_KEY=
AGENT_MODEL=models/gemini-3.5-flash

# Allow anyone to create an account. When false, only the first account can be
# created. Defaults: true in docker-compose.yml, false in docker-compose.server.yml.
# ALLOW_REGISTRATION=false

# Optional: receives JSON alerts for critical daily-checkup findings.
# ADMIN_ALERT_WEBHOOK_URL=https://your-alert-endpoint.example/health

# Servers join by clicking Add on the dashboard; no collector settings needed.
# Optional: an enrollment key (Connect a server → Advanced) skips that approval.
# HOMELAB_ENROLL_KEY=
# Optional: override the name shown on the dashboard (defaults to the hostname).
HOMELAB_SERVER_NAME=

# --- Hosting on a remote server ---
# Public HTTPS: point DOMAIN's DNS at the server, open ports 80/443, then run
#   docker compose --profile https up -d --build
# DOMAIN=homelab.example.com
# SESSION_COOKIE_SECURE=true
# Keep the plain-HTTP dashboard port off the internet when Caddy is in front:
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=5173
